# ============================================================
# Viben Desktop 环境变量（模板）
# 复制此文件为 .env 后修改
# ============================================================

# 分析服务 Provider
# firebase — Google Firebase Analytics（默认）
# volcengine — 火山引擎应用分析
VITE_ANALYTICS_PROVIDER=firebase

# 应用版本号（与 package.json version 同步）
VITE_APP_VERSION=0.1.0

# 错误监控
# 错误由 Analytics Provider 统一处理，无需额外配置
# - 火山引擎: @apmplus/web 自动采集 JS 异常 + ErrorBoundary 上报渲染错误
# - Firebase: logEvent('exception', ...) 上报异常
