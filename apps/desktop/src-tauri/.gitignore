# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binaries (built separately)
/binaries/*
!/binaries/.gitkeep

# Android signing keys (DO NOT COMMIT)
/keys/
*.keystore
*.jks

# Generated Android/iOS projects
/gen/android/
/gen/apple/
