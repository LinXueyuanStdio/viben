{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browse MCP",
  "version": "0.1.0",
  "identifier": "com.browsemcp.app",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["browsemcp"]
      }
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Browse MCP",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      },
      {
        "label": "tray-popup",
        "title": "Server Status",
        "width": 400,
        "height": 500,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "url": "/tray-popup"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
