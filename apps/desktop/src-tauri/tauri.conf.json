{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viben",
  "version": "0.1.0",
  "identifier": "com.viben.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "viben"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/LinXueyuanStdio/viben/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDRTE1Qjc4RDQ2OEVGODQKUldTRTcyalVlRnZoSEdmd0NFWHZqakRNcHJ4S21Ra2w4NlBjcG9pQTdQdjFDdVRYSURkVG14TE8K"
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1549",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Viben",
        "url": "/index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "useHttpsScheme": true
      },
      {
        "label": "pet-window",
        "title": "Viben Pet",
        "width": 128,
        "height": 128,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "url": "/pet-window.html"
      },
      {
        "label": "chat-window",
        "title": "Chat",
        "width": 420,
        "height": 600,
        "minWidth": 360,
        "minHeight": 400,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "useHttpsScheme": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true,
        "focus": true,
        "url": "/chat-window.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/viben"
    ],
    "resources": [
      "resources/ni_hao_wei_ben.onnx",
      "resources/templates"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "iOS": {
      "developmentTeam": ""
    },
    "android": {
      "minSdkVersion": 34
    }
  }
}
