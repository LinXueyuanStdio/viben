{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Common capabilities for all platforms",
  "windows": ["main", "tray-popup", "screenshot-overlay", "pet-window", "chat-window", "page-preview-*", "page-preview", "workspace-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-show",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:default",
    "process:allow-restart",
    "process:allow-exit",
    "window-state:default",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "store:allow-delete",
    "mcp-bridge:default"
  ]
}
