{
  "name": "viben",
  "version": "0.1.0",
  "description": "CLI for Viben - Agent Swarm × Code Evolution platform",
  "keywords": [
    "viben",
    "browse-mcp",
    "mcp",
    "ai",
    "agent",
    "orchestration",
    "workspace",
    "claude",
    "automation",
    "cli"
  ],
  "author": "LinXueyuanStdio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LinXueyuanStdio/viben.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/LinXueyuanStdio/viben",
  "bugs": {
    "url": "https://github.com/LinXueyuanStdio/viben/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "viben": "./bin/viben.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && npm run copy-templates",
    "copy-templates": "rm -rf dist/templates && cp -r ../../packages/core/templates dist/templates",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.71",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api": "^1.9.0",
    "@fastify/otel": "^0.18.1",
    "@opentelemetry/instrumentation-http": "^0.212.0",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "adm-zip": "^0.5.16",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "fastify": "^5.8.2",
    "gray-matter": "^4.0.3",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "shell-quote": "^1.8.3",
    "undici": "^7.24.0",
    "ws": "^8.18.0",
    "xstate": "^5.18.0",
    "yaml": "^2.4.5"
  },
  "optionalDependencies": {
    "@larksuiteoapi/node-sdk": "^1.41.2",
    "cloudflared": "^0.7.1",
    "node-notifier": "^10.0.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@viben/core": "workspace:*",
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
