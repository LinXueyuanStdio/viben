{
  "name": "viben",
  "version": "0.1.0",
  "description": "CLI for Viben - Agent Swarm × Code Evolution platform",
  "keywords": [
    "viben",
    "browse-mcp",
    "mcp",
    "ai",
    "agent",
    "orchestration",
    "workspace",
    "claude",
    "automation",
    "cli"
  ],
  "author": "LinXueyuanStdio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LinXueyuanStdio/viben.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/LinXueyuanStdio/viben",
  "bugs": {
    "url": "https://github.com/LinXueyuanStdio/viben/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "viben": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm build:node",
    "build:node": "tsup && npm run copy-templates",
    "build:sidecar": "tsx scripts/build-sidecar.ts",
    "build:sidecar:current": "tsx scripts/build-sidecar.ts --platform current",
    "build:sidecar:macos-x64": "tsx scripts/build-sidecar.ts --platform macos-x64",
    "copy-templates": "node -e \"const{rmSync,cpSync}=require('fs');const d='dist/templates';try{rmSync(d,{recursive:true})}catch{};cpSync('../../packages/core/templates',d,{recursive:true})\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.144",
    "@anthropic-ai/sdk": "^0.98.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/otel": "^0.18.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "adm-zip": "^0.5.17",
    "bonjour-service": "^1.3.0",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "cron-parser": "^5.5.0",
    "fastify": "^5.8.5",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.1.11",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "shell-quote": "^1.8.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "undici": "^8.10.0",
    "ws": "^8.18.0",
    "xstate": "^5.30.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@larksuiteoapi/node-sdk": "^1.41.2",
    "cloudflared": "^0.7.1",
    "node-notifier": "^10.0.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@viben/core": "workspace:*",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
