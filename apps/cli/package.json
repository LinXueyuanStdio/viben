{
  "name": "viben",
  "version": "0.1.0",
  "description": "CLI for Viben - Orchestrate AI agent clusters in your local workspace",
  "keywords": [
    "viben",
    "browse-mcp",
    "mcp",
    "ai",
    "agent",
    "orchestration",
    "workspace",
    "claude",
    "automation",
    "cli"
  ],
  "author": "LinXueyuanStdio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LinXueyuanStdio/viben.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/LinXueyuanStdio/viben",
  "bugs": {
    "url": "https://github.com/LinXueyuanStdio/viben/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "viben": "./bin/viben.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@viben/cli-rs": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cron-parser": "^5.5.0",
    "node-cron": "^4.2.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@vitest/coverage-v8": "^3.0.0",
    "discord.js": "^14.25.1",
    "node-telegram-bot-api": "^0.67.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
