{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@viben/editor": ["../src"],
      "@viben/editor/*": ["../src/*"]
    }
  },
  "include": ["*.tsx", "*.ts", "src/**/*", "../src/**/*.d.ts"]
}
