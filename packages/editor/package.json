{
  "name": "@viben/editor",
  "version": "1.0.0",
  "private": true,
  "description": "Yoopta editor markdown roundtrip utilities and plugin registry for Viben",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./yoopta/editor.css": "./src/yoopta/editor.css"
  },
  "files": [
    "dist",
    "src/yoopta/editor.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/react": "^0.27.16",
    "@yoopta/accordion": "workspace:*",
    "@yoopta/blockquote": "workspace:*",
    "@yoopta/callout": "workspace:*",
    "@yoopta/carousel": "workspace:*",
    "@yoopta/code": "workspace:*",
    "@yoopta/divider": "workspace:*",
    "@yoopta/editor": "workspace:*",
    "@yoopta/embed": "workspace:*",
    "@yoopta/emoji": "workspace:*",
    "@yoopta/exports": "workspace:*",
    "@yoopta/file": "workspace:*",
    "@yoopta/headings": "workspace:*",
    "@yoopta/image": "workspace:*",
    "@yoopta/link": "workspace:*",
    "@yoopta/lists": "workspace:*",
    "@yoopta/marks": "workspace:*",
    "@yoopta/math": "workspace:*",
    "@yoopta/mention": "workspace:*",
    "@yoopta/paragraph": "workspace:*",
    "@yoopta/steps": "workspace:*",
    "@yoopta/table": "workspace:*",
    "@yoopta/table-of-contents": "workspace:*",
    "@yoopta/tabs": "workspace:*",
    "@yoopta/themes-shadcn": "workspace:*",
    "@yoopta/ui": "workspace:*",
    "@yoopta/video": "workspace:*",
    "clsx": "^2.1.1",
    "i18next": "^26.0.0",
    "katex": "^0.16.11",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-i18next": "^17.0.0",
    "slate": "^0.120.0",
    "slate-react": "^0.120.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "jsdom": "^28.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
