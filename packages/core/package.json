{
  "name": "@viben/core",
  "version": "0.1.0",
  "description": "Core library for Viben - Agent Swarm × Code Evolution with FileEvo, Multi-Agent orchestration, and XState Task System",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "require": "./dist/shared.cjs"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js",
      "require": "./dist/agents/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js",
      "require": "./dist/models/index.cjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js",
      "require": "./dist/telemetry/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.24.2",
    "@agentclientprotocol/sdk": "^0.17.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.144",
    "@anthropic-ai/sdk": "^0.97.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/otel": "^0.18.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/websocket": "^11.2.0",
    "@hypothesi/tauri-mcp-server": "^0.11.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/ed25519": "^3.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.212.0",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@viben/api-client": "workspace:*",
    "@viben/browse-sdk": "workspace:*",
    "@viben/page-sdk": "workspace:*",
    "adm-zip": "^0.5.17",
    "bonjour-service": "^1.4.0",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "cloudflared": "^0.7.1",
    "commander": "^12.1.0",
    "cron-parser": "^5.5.0",
    "fastify": "^5.8.5",
    "firebase": "^12.15.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.1.11",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "shell-quote": "^1.8.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "undici": "^7.22.0",
    "ws": "^8.20.1",
    "xstate": "^5.31.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.18.1",
    "archiver": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
