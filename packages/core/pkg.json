{
  "$schema": "https://raw.githubusercontent.com/vercel/pkg/main/dictionary/pkg.json",
  "name": "viben",
  "pkg": {
    "scripts": [
      "dist/**/*.js",
      "dist/**/*.cjs"
    ],
    "assets": [
      "templates/**/*",
      "node_modules/@modelcontextprotocol/sdk/**/*",
      "node_modules/@anthropic-ai/sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk/**/*"
    ],
    "targets": [
