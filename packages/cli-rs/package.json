{
  "name": "@viben/cli-rs",
  "version": "0.1.0",
  "description": "Viben core native bindings - Rust NAPI bindings for Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "viben-core",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --target aarch64-apple-darwin --release --cargo-cwd ../../crates/viben-core --cargo-name viben_core --features napi --cargo-flags=\"--lib\"",
    "build:debug": "napi build --target aarch64-apple-darwin --cargo-cwd ../../crates/viben-core --cargo-name viben_core --features napi --cargo-flags=\"--lib\"",
    "build:all": "napi build --platform --release --cargo-cwd ../../crates/viben-core --cargo-name viben_core --features napi --cargo-flags=\"--lib\"",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LinXueyuanStdio/viben.git",
    "directory": "packages/cli-rs"
  }
}
