{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@viben/pet": ["../src"],
      "@viben/pet/*": ["../src/*"]
    }
  },
  "include": ["*.tsx", "*.ts", "../src/**/*"]
}
