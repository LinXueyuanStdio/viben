{
  "name": "viben",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Swarm × Code Evolution - FileEvo optimization, Multi-Agent orchestration, MCP Protocol, XState Task System, and Idea Generation",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "prepare": "node scripts/install-git-hooks.js",
    "check:lockfile": "./scripts/check-pnpm-lockfile.sh",
    "clean": "turbo clean && rm -rf node_modules",
    "code-stats": "python scripts/code-stats.py",
    "desktop": "pnpm --filter @viben/desktop",
    "desktop:dev": "pnpm --filter @viben/desktop tauri-dev",
    "desktop:build": "pnpm --filter @viben/desktop tauri-build",
    "desktop:restart": "./scripts/restart-desktop.sh",
    "desktop:restart:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\restart-desktop.ps1",
    "gateway:restart": "./scripts/restart-gateway.sh",
    "gateway:restart:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\restart-gateway.ps1",
    "gateway:restart:win:force": "powershell -ExecutionPolicy Bypass -File .\\scripts\\restart-gateway.ps1 -Force",
    "gateway:build": "./scripts/restart-gateway.sh --build",
    "cli:native": "./scripts/build-cli-native.sh",
    "cli:native:debug": "./scripts/build-cli-native.sh --debug",
    "viben": "pnpm --filter viben",
    "mcp-server": "pnpm --filter @viben/mcp-server",
    "docs": "pnpm --filter @viben/docs",
    "release": "./scripts/release.sh",
    "check:release": "./scripts/check-before-release.sh",
    "generate-client-sdk": "tsx scripts/generate-client-sdk/generate.ts"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^4.0.4",
    "@rollup/plugin-commonjs": "^23.0.7",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.3.0",
    "@svgr/rollup": "^6.5.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.0",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^12.1.5",
    "rollup": "^3.30.0",
    "rollup-plugin-generate-package-json": "^3.2.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-sourcemaps": "0.4.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "sass": "^1.99.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@swc/helpers": "^0.5.17",
      "lucide-react": "^1.16.0",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ],
      "allowedVersions": {
        "@emoji-mart/react>react": ">=19"
      }
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
