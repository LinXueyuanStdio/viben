e\": 0,\n  \"next_action\": [\n    {\n      \"phase\": 1,\n      \"action\": \"implement\"\n    },\n    {\n      \"phase\": 2,\n      \"action\": \"check\"\n    },\n    {\n      \"phase\": 3,\n      \"action\": \"finish\"\n    },\n    {\n      \"phase\": 4,\n      \"action\": \"create-pr\"\n    }\n  ],\n  \"commit\": null,\n  \"pr_url\": null,\n  \"subtasks\": [],\n  \"relatedFiles\": [],\n  \"notes\": \"\"\n}","stderr":"","interrupted":false,"isImage":false}}
